{
  "name": "agentkit",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "test": "bun test --timeout 60000",
    "test:core": "bun test packages/core",
    "test:contracts": "bun test packages/contracts",
    "test:client": "bun test packages/client",
    "test:react": "bun test packages/react",
    "test:testing": "bun test packages/testing",
    "typecheck": "bun run typecheck:contracts && bun run typecheck:client && bun run typecheck:react && bun run typecheck:core && bun run typecheck:testing && bun run typecheck:native && bun run typecheck:examples",
    "typecheck:contracts": "npx --no-install tsc -p packages/contracts/tsconfig.json",
    "typecheck:client": "npx --no-install tsc -p packages/client/tsconfig.json",
    "typecheck:react": "npx --no-install tsc -p packages/react/tsconfig.json",
    "typecheck:core": "npx --no-install tsc -p packages/core/tsconfig.json",
    "typecheck:testing": "npx --no-install tsc -p packages/testing/tsconfig.json",
    "typecheck:native": "npx --no-install tsc -p packages/native/tsconfig.json",
    "typecheck:examples": "npx --no-install tsc -p examples/desktop-host/tsconfig.json && npx --no-install tsc -p examples/coding-agent/tsconfig.json",
    "build": "bun run build:contracts && bun run build:client && bun run build:react && bun run build:native && bun run build:core && bun run build:testing",
    "build:contracts": "npx --no-install tsc -p packages/contracts/tsconfig.build.json",
    "build:client": "npx --no-install tsc -p packages/client/tsconfig.build.json",
    "build:react": "npx --no-install tsc -p packages/react/tsconfig.build.json",
    "build:core": "npx --no-install tsc -p packages/core/tsconfig.build.json",
    "build:testing": "npx --no-install tsc -p packages/testing/tsconfig.build.json",
    "smoke:node": "node scripts/node-smoke.mjs",
    "smoke:pack": "node scripts/pack-smoke.mjs",
    "build:umbrella": "node scripts/build-umbrella.mjs",
    "smoke:umbrella": "node scripts/umbrella-smoke.mjs",
    "ci": "bun install --frozen-lockfile && bun run typecheck && bun test && bun run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test:coverage": "bun test --timeout 60000 --coverage",
    "qualify:local": "node scripts/qualify-local.mjs",
    "qualify:cold": "node scripts/qualify-cold-packages.mjs",
    "check:local-actions": "node scripts/check-local-actions.mjs",
    "check:native-package": "node rust/scripts/check-native-package.mjs",
    "check:api": "node scripts/check-public-api.mjs",
    "check:arch": "node rust/scripts/check-arch.mjs",
    "check:deny": "cd rust && cargo deny check",
    "check:machete": "cd rust && cargo machete",
    "check:rust-api": "node rust/scripts/public-api.mjs",
    "update:rust-api": "node rust/scripts/public-api.mjs --update",
    "check:native-umbrella": "node rust/scripts/check-native-umbrella.mjs",
    "update:api": "node scripts/check-public-api.mjs --update",
    "test:coding-agent": "bun test examples/coding-agent",
    "start:coding-agent": "bun run examples/coding-agent/src/main.ts",
    "build:native": "bun run --cwd packages/native build",
    "build:fixture": "cargo build --manifest-path rust/Cargo.toml -p agentkit-runtime --example http_fixture --locked"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@microsoft/api-extractor": "7.60.0",
    "typescript": "5.9.3",
    "typescript-language-server": "^6.0.3"
  }
}
