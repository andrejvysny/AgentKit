{
  "name": "@agentkit/adapters-sqlite",
  "version": "0.1.0-dev",
  "description": "Shared durable SQLite AssistantStore with Bun and Node drivers.",
  "license": "MIT",
  "engines": {
    "node": ">=22",
    "bun": ">=1.3"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./node": {
      "types": "./src/node.ts",
      "default": "./src/node.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./node": {
        "types": "./dist/node.d.ts",
        "import": "./dist/node.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test tests",
    "dev": "tsc -p tsconfig.build.json --watch",
    "prepack": "node ../../scripts/prepack-publish-config.mjs apply",
    "postpack": "node ../../scripts/prepack-publish-config.mjs restore"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/andrejvysny/AgentKit.git",
    "directory": "packages/adapters-sqlite"
  },
  "dependencies": {
    "@agentkit/contracts": "workspace:*",
    "@agentkit/host": "workspace:*",
    "@agentkit/mcp-client": "workspace:*"
  },
  "devDependencies": {
    "@agentkit/adapters-memory": "workspace:*",
    "@agentkit/testing": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "@types/bun": "^1.3.5",
    "typescript": "^5.8.3"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3"
  }
}
