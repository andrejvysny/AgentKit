{
  "name": "agentkit",
  "version": "0.8.0",
  "description": "Embeddable AI-assistant framework: typed contracts, REST client, React hooks, provider-lane core facade and the native Rust engine binding, as one installable package with subpath imports.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=20",
    "bun": ">=1.3.14"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./native": {
      "types": "./dist/native/index.d.ts",
      "import": "./dist/native/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/andrejvysny/AgentKit.git",
    "directory": "packages/agentkit"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "optionalDependencies": {
    "@agentkit/native-darwin-arm64": "0.1.0-dev",
    "@agentkit/native-darwin-x64": "0.1.0-dev",
    "@agentkit/native-linux-arm64-gnu": "0.1.0-dev",
    "@agentkit/native-linux-x64-gnu": "0.1.0-dev",
    "@agentkit/native-win32-x64-msvc": "0.1.0-dev"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
