{
  "name": "agentkit",
  "version": "0.4.0-dev",
  "description": "Embeddable AI-assistant framework: chat-with-tools loop, durable task orchestration, and storage/transport adapters, as one installable package with subpath imports.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20",
    "bun": ">=1.3"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./host": {
      "types": "./dist/host/index.d.ts",
      "import": "./dist/host/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./mcp-client": {
      "types": "./dist/mcp-client/index.d.ts",
      "import": "./dist/mcp-client/index.js"
    },
    "./transport-http": {
      "types": "./dist/transport-http/index.d.ts",
      "import": "./dist/transport-http/index.js"
    },
    "./mcp-server": {
      "types": "./dist/mcp-server/index.d.ts",
      "import": "./dist/mcp-server/index.js"
    },
    "./adapters-memory": {
      "types": "./dist/adapters-memory/index.d.ts",
      "import": "./dist/adapters-memory/index.js"
    },
    "./adapters-sqlite": {
      "types": "./dist/adapters-sqlite/index.d.ts",
      "import": "./dist/adapters-sqlite/index.js"
    },
    "./runner-local": {
      "types": "./dist/runner-local/index.d.ts",
      "import": "./dist/runner-local/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/andrejvysny/AgentKit.git",
    "directory": "packages/agentkit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@sinclair/typebox": "^0.34.0",
    "ajv": "^8.17.1"
  }
}
