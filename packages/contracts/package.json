{
  "name": "@agentkit/contracts",
  "version": "0.1.0-dev",
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "bun": ">=1.3"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test tests",
    "prepack": "node ../../scripts/prepack-publish-config.mjs apply",
    "postpack": "node ../../scripts/prepack-publish-config.mjs restore"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/andrejvysny/AgentKit.git",
    "directory": "packages/contracts"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "@types/bun": "^1.3.5",
    "ajv": "^8.17.1"
  }
}
