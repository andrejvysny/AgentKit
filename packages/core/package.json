{
  "name": "@agentkit/core",
  "version": "0.5.0-dev",
  "description": "Headless AI agent runtime primitives: providers, tools, prompts, and run events. Pure TypeScript; no DB, no HTTP framework, no DOM, no provider SDKs.",
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "bun": ">=1.3"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test tests",
    "dev": "tsc -p tsconfig.build.json --watch",
    "prepack": "node ../../scripts/prepack-publish-config.mjs apply",
    "postpack": "node ../../scripts/prepack-publish-config.mjs restore"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/andrejvysny/AgentKit.git",
    "directory": "packages/core"
  },
  "dependencies": {
    "@agentkit/contracts": "workspace:*",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@agentkit/testing": "workspace:*",
    "@types/bun": "^1.3.5",
    "typescript": "^5.8.3"
  }
}
