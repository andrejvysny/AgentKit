{
  "name": "@agentkit/mcp-server",
  "version": "0.1.0-dev",
  "description": "MCP server bridge: exposes an AgentKit host's tools as an MCP server over streamable HTTP, as a fetch-standard handler.",
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "bun": ">=1.3"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test tests",
    "prepack": "node ../../scripts/prepack-publish-config.mjs apply",
    "postpack": "node ../../scripts/prepack-publish-config.mjs restore"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/andrejvysny/AgentKit.git",
    "directory": "packages/mcp-server"
  },
  "dependencies": {
    "@agentkit/contracts": "workspace:*",
    "@agentkit/core": "workspace:*",
    "@agentkit/host": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@agentkit/testing": "workspace:*",
    "@types/bun": "^1.3.5",
    "typescript": "^5.8.3"
  }
}
