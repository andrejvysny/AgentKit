{
  "name": "@agentkit/native",
  "version": "0.1.0-dev",
  "description": "Thin Node-API binding over the native Rust AgentKit runtime: durable sessions, events, approvals. No logic in TypeScript.",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20",
    "bun": ">=1.3"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist",
    "src",
    "generated/index.js",
    "generated/index.d.ts",
    "generated/*.node",
    "error-codes.json",
    "README.md"
  ],
  "napi": {
    "name": "agentkit-native",
    "binaryName": "agentkit-native",
    "dtsHeader": "declare type JsonValue = string | number | boolean | null | JsonValue[] | { [key: string]: JsonValue };",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:native": "napi build --platform --release --format esm --manifest-path ../../rust/crates/napi/Cargo.toml --output-dir generated --js index.js --dts index.d.ts",
    "test": "bun test tests",
    "prepack": "node ../../scripts/prepack-publish-config.mjs apply",
    "postpack": "node ../../scripts/prepack-publish-config.mjs restore"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/andrejvysny/AgentKit.git",
    "directory": "packages/native"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.4.0",
    "@types/bun": "^1.3.5",
    "typescript": "^5.8.3"
  }
}
