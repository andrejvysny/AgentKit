{
  "name": "@agentkit/react",
  "version": "0.1.0-dev",
  "description": "Headless React hooks over @agentkit/client: chat turns with optimistic sends and streaming deltas, live runs, branches, proposals, providers. Hooks only — no components, no routing, no styling.",
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "bun": ">=1.3"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test tests",
    "prepack": "node ../../scripts/prepack-publish-config.mjs apply",
    "postpack": "node ../../scripts/prepack-publish-config.mjs restore"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/andrejvysny/AgentKit.git",
    "directory": "packages/react"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@agentkit/client": "workspace:*",
    "@agentkit/contracts": "workspace:*"
  },
  "devDependencies": {
    "@agentkit/adapters-memory": "workspace:*",
    "@agentkit/core": "workspace:*",
    "@agentkit/host": "workspace:*",
    "@agentkit/runner-local": "workspace:*",
    "@agentkit/testing": "workspace:*",
    "@agentkit/transport-http": "workspace:*",
    "@happy-dom/global-registrator": "^20.0.0",
    "@testing-library/react": "^16.3.0",
    "@types/bun": "^1.3.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.8.3"
  }
}
