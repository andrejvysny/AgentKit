                  "type": "string"
                }
              },
              "required": ["source", "wireId", "targetPointNm"]
            }
          }
        },
        "required": ["title", "summary"]
      }
    },
    {
      "name": "designer_resolve_design",
      "version": "1",
      "effect": "read",
      "capability": "designer.read",
      "description": "Resolve a design by natural-language name. On a clean unambiguous match in an unbound chat, binds the chat to that design.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "allowAlreadyBound": {
            "type": "boolean"
          }
        },
        "required": ["query"]
      }
    },
    {
      "name": "library_get_component_detail",
      "version": "1",
      "effect": "read",
      "capability": "library.read",
      "description": "Fetch full compact detail for one installed library component (symbol summary, footprint summary, variants, provenance). `componentId` may be the UUID returned by library_search_components OR the component name (e.g. \"ATMEGA16U4-AU\"); name lookup falls back to a library search.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "componentId": {
            "type": "string",
            "description": "Component UUID (preferred) or exact/partial component name. Name lookup will use library_search_components and pick the best match."
          },
          "includeRaw": {
            "type": "boolean"
          }
        },
        "required": ["componentId"]
      }
    },
    {
      "name": "library_resolve_bom",
      "version": "1",
      "effect": "read",
      "capability": "library.read.bom",
      "description": "Resolve a multi-item circuit BOM against the local OpenPCB library. Use this for circuit creation/planning before creating a design or placing components. Treat values/colors as instance properties when only generic components exist.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "goal": {
            "type": "string"
          },
          "defaults": {
            "type": "object",
            "properties": {
              "supplyVoltage": {
                "type": "string"
              },
              "blinkRate": {
                "type": "string"
              },
              "packagePreference": {
                "type": "string"
              }
            }
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string"
                },
                "query": {
                  "type": "string"
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 50
                },
                "value": {
                  "type": "string"
                },
                "values": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "attributes": {
                  "type": "object"
                },
                "requirements": {
                  "type": "object"
                }
              },
              "required": ["role", "query"]
            }
          },
          "limitPerItem": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          }
        },
        "required": ["items"]
      }
    },
    {
      "name": "library_search_components",
      "version": "1",
      "effect": "read",
      "capability": "library.read",
      "description": "Search the local OpenPCB component library by query, or list all installed components when query is omitted. Supports optional requirements (voltage/current/package/etc.). Returns ranked matches paginated by limit (default 10, max 50). If none match, returns generic suggestions and import guidance.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Natural-language description of the component. Omit (or leave empty) to list all installed components."
          },
          "requirements": {
            "type": "object",
            "properties": {
              "function": {
                "type": "string"
              },
              "voltage": {
                "type": "string"
              },
              "current": {
                "type": "string"
              },
              "package": {
                "type": "string"
              },
              "mountType": {
                "type": "string"
              },
              "value": {
                "type": "string"
              },
              "tolerance": {
                "type": "string"
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "required": []
      }
    }
  ]
