{
  "name": "@agentkit/toolpacks-coding",
  "version": "0.1.0-dev",
  "description": "Optional coding tool pack for @agentkit/host: confined filesystem read/search/edit tools, read-only git inspection, sandboxed command and test execution, and a CodingPermissionGuard. Node APIs only; macOS-first.",
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "bun": ">=1.3"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test tests",
    "dev": "tsc -p tsconfig.build.json --watch",
    "prepack": "node ../../scripts/prepack-publish-config.mjs apply",
    "postpack": "node ../../scripts/prepack-publish-config.mjs restore"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/andrejvysny/AgentKit.git",
    "directory": "packages/toolpacks-coding"
  },
  "dependencies": {
    "@agentkit/contracts": "workspace:*",
    "@agentkit/core": "workspace:*",
    "@agentkit/host": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "typescript": "^5.8.3"
  }
}
