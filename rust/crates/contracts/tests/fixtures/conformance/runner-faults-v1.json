{
  "formatVersion": 1,
  "startMs": 1000,
  "leaseTtlMs": 1000,
  "retryBaseMs": 200,
  "scenarios": [
    {
      "name": "safe_retry",
      "schedule": [
        "execute at 1000; fail before dispatch with retryable=true",
        "observe retry deadline 1200",
        "advance to 1199; assert no dispatch",
        "advance to 1200; complete"
      ],
      "delta": "TS stores the backoff deadline in runner memory and retains a live lease; Rust persists the deadline before releasing the attempt lease. The observable due time and dispatch trace agree.",
      "expected": {
        "typescript": [
          {
            "label": "backoff",
            "status": "running",
            "attemptCount": 1,
            "attempts": [
              "failed"
            ],
            "effects": 0,
            "events": [
              {
                "seq": 0,
                "type": "fault.started",
                "data": {
                  "attempt": 1
                }
              }
            ],
            "poisonCount": 0,
            "deadLetter": false,
            "failureReason": null,
            "retryDue": 1200,
            "durableRetryDue": null
          },
          {
            "label": "before_due",
            "status": "running",
            "attemptCount": 1,
            "attempts": [
              "failed"
            ],
            "effects": 0,
            "events": [
              {
                "seq": 0,
                "type": "fault.started",
                "data": {
                  "attempt": 1
                }
              }
            ],
            "poisonCount": 0,
            "deadLetter": false,
            "failureReason": null
          },
          {
            "label": "settled",
            "status": "completed",
            "attemptCount": 2,
            "attempts": [
              "failed",
              "completed"
            ],
            "effects": 1,
            "events": [
              {
                "seq": 0,
                "type": "fault.started",
                "data": {
                  "attempt": 1
                }
              },
              {
                "seq": 1,
                "type": "fault.started",
                "data": {
                  "attempt": 2
                }
              },
              {
                "seq": 2,
                "type": "fault.committed",
                "data": {
                  "effect": 1
                }
              }
            ],
            "poisonCount": 0,
            "deadLetter": false,
            "failureReason": null
          }
        ],
        "rust": [
          {
            "label": "backoff",
            "status": "running",
            "attemptCount": 1,
            "attempts": [
              "failed"
            ],
            "effects": 0,
