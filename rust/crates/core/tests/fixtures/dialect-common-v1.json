          },
          "path": {
            "type": "string",
            "description": "Limit to this path (relative to the workspace root)."
          },
          "staged": {
            "type": "boolean",
            "description": "Show staged changes (command diff only)."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200,
            "description": "Maximum number of commits (command log only)."
          },
          "rev": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Commit, branch, tag or range, e.g. HEAD~2."
          }
        },
        "required": [
          "command"
