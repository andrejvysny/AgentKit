        {
          "name": "write_file",
          "required": [
            "path",
            "content"
          ],
          "effect": {
            "kind": "write",
            "key_arg": "path",
            "value_arg": "content"
          }
        },
        {
          "name": "append_file",
          "required": [
            "path",
            "content"
          ],
          "effect": {
            "kind": "append",
            "key_arg": "path",
            "value_arg": "content"
          }
        },
        {
          "name": "delete_file",
          "required": [
            "path"
          ],
          "effect": {
            "kind": "remove",
            "key_arg": "path"
          }
        }
      ],
      "max_turns": 6,
      "workspace": {
        "notes.txt": "alpha beta"
      },
      "expect": {
        "calls": [
          {
            "tool": "read_file",
            "args": {
              "path": "notes.txt"
            }
          }
        ],
        "state": [],
        "answer_contains": [
          "alpha beta"
        ]
      }
    },
