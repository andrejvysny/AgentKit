            "poisonCount": 0,
            "deadLetter": false,
            "failureReason": null
          },
          {
            "label": "settled",
            "status": "completed",
            "attemptCount": 2,
            "attempts": [
              "failed",
              "completed"
            ],
            "effects": 1,
            "events": [
              {
                "seq": 0,
