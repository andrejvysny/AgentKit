    {
      "name": "uncertain_write",
      "schedule": [
        "commit effect and evidence at 1000",
        "throw raw ECONNRESET after commit",
        "advance to 1200"
      ],
      "delta": "Approved safety correction: frozen TS classifies raw ECONNRESET as transient and repeats the committed write; Rust requires explicit safe-to-retry evidence and fails uncertain_outcome without replay.",
      "expected": {
        "typescript": [
          {
            "label": "settled",
            "status": "completed",
            "attemptCount": 2,
            "attempts": [
              "failed",
              "completed"
