                "seq": 2,
                "type": "fault.started",
                "data": {
                  "attempt": 2
                }
              },
              {
                "seq": 3,
                "type": "fault.committed",
                "data": {
                  "effect": 2
                }
              }
            ],
            "poisonCount": 0,
            "deadLetter": false,
            "failureReason": null
          }
        ],
        "rust": [
