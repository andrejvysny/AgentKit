# Agent sandbox image v1: the pinned build manifest.
# Sourced by build.sh. Every build input that can change is named here by
# digest, snapshot timestamp or sha256; apt-packages.txt and
# requirements.lock are the package lists this manifest pins.
# Changing any line here is a new image (and a new digest).

IMAGE_NAME=agentkit-sandbox
IMAGE_VERSION=v1

# Target platforms of the OCI index. agentkit-sandboxd is built for each
# in the matching variant of RUST_IMAGE (one multi-arch index digest).
# build.sh wraps a one-platform build in an index too, so the image is
# always referenced by index digest.
PLATFORMS=linux/amd64,linux/arm64

# BuildKit used to build (output compression and layer layout depend on it).
# moby/buildkit v0.35.1 (buildx-stable-1 on 2026-11-25), multi-arch index digest.
BUILDKIT_IMAGE=moby/buildkit:buildx-stable-1@sha256:baf6138eb8c37644800c7c913fba051e840ebb9ba13eaf92d92ef9a1712d0b4c

# Debian stable (trixie) slim, multi-arch index digest. Built by
# debuerreotype from snapshot 20261123T000000Z.
BASE_IMAGE=docker.io/library/debian:trixie-slim@sha256:8aa5a7bf5a1955bddbe7d74fcdd0b91ab30e74362a8b73af672b0481b35b44a0

# apt sources point at snapshot.debian.org at this instant, so every
# package version in apt-packages.txt resolves to one fixed version.
DEBIAN_SNAPSHOT=20261123T000000Z

# File timestamps in the image and the image config "created" field.
# Equals DEBIAN_SNAPSHOT (2026-11-23T00:00:00Z).
SOURCE_DATE_EPOCH=1795392000

# Node.js LTS (26.x "Lithium"), official linux tarballs, sha256 from
# https://nodejs.org/dist/v26.13.1/SHASUMS256.txt. npm is the copy bundled
# in the tarball; no other npm packages are installed globally.
NODE_VERSION=26.13.1
NODE_SHA256_ARM64=80a330b35415382878df18d41afbd106ea89bfb3be0087d6608e289a14c5cc7d
NODE_SHA256_AMD64=518674de2b621728a5e4486f5fb3b7d2900bb3cc4aa97969edaa463db99f9778

# PyPI resolution cut-off used by `build.sh lock-pip` (uv --exclude-newer).
PIP_EXCLUDE_NEWER=2026-11-23T00:00:00Z
PYTHON_VERSION=3.13

# agentkit-sandboxd (ADR 0039): `build.sh sandboxd` builds it from ../rust
# (Cargo.lock, release profile) as a static musl binary inside this image,
# per platform in its native variant (linux/amd64, linux/arm64), with the
# crate registry fetched first and the build itself offline.
# rust:1.97.0-alpine (matches rust/rust-toolchain.toml), index digest.
RUST_IMAGE=docker.io/library/rust:1.97.0-alpine@sha256:ec9c91e77119ce498cd1e87d96d77e0f75b2cee21655a29bc2bf75a51a2b20a4
# sha256 of out/agentkit-sandboxd-<arch>; the Dockerfile refuses any other.
SANDBOXD_SHA256_AMD64=bfa088cf25115c698bb2d4297543088d14dffd663482957fd630c21b6829bf7a
SANDBOXD_SHA256_ARM64=8dcf8eb4f26adba031d88501e5f4d38d94d6f92f6fce2016f0cf1016cfc38099
