# Kernel config fragment of the agent sandbox microVM (ADR 0040 §4), merged
# onto `make allnoconfig` for arm64 and then `make olddefconfig`.
# allnoconfig, not defconfig: with MODULES off, every =m of defconfig would
# turn into =y and build the whole driver tree in. Every line here must hold
# in the final .config; check-config.sh fails the build otherwise (an option
# whose dependencies are missing is dropped silently).
#
# Guest hardware (Virtualization.framework, direct Linux boot, device tree):
# GIC, PSCI, arch timer, a PL031 RTC and virtio devices on a generic ECAM
# PCI host bridge. No network device, no initramfs, no modules.

CONFIG_LOCALVERSION="-agentkit"
# CONFIG_LOCALVERSION_AUTO is not set
# CONFIG_MODULES is not set
# CONFIG_BLK_DEV_INITRD is not set
# CONFIG_COMPAT is not set
# CONFIG_BOOT_CONFIG is not set

# Platform
CONFIG_SMP=y
CONFIG_PCI=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_PCI_MSI=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_DRV_PL031=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y

# Userland of a normal Debian system (glibc, Python, Node, git)
CONFIG_MULTIUSER=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_AIO=y
CONFIG_IO_URING=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_RSEQ=y
CONFIG_FILE_LOCKING=y
CONFIG_POSIX_TIMERS=y
CONFIG_INOTIFY_USER=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
# Debian's file(1) applies a seccomp filter and fails without it.
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_KALLSYMS=y
# No user namespaces: uid 1000 cannot build a mount namespace in which the
# empty file over /proc/cmdline could be undone.
# CONFIG_USER_NS is not set

# Memory: no swap; the balloon can migrate pages
# CONFIG_SWAP is not set
CONFIG_COMPACTION=y
CONFIG_MIGRATION=y
CONFIG_MEMORY_BALLOON=y
CONFIG_BALLOON_COMPACTION=y

# Console and terminals: hvc0 is the virtio console
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HVC_DRIVER=y
# agentkit-vm-init powers off through /proc/sysrq-trigger (the image has no
# poweroff binary); the keyboard functions stay off.
CONFIG_MAGIC_SYSRQ=y
CONFIG_MAGIC_SYSRQ_DEFAULT_ENABLE=0x0
# The boot log carries the kernel command line, and with it the channel token.
CONFIG_SECURITY_DMESG_RESTRICT=y
# CONFIG_DEVMEM is not set

# Virtio
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y

# Block and filesystems
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_VIRTIO_BLK=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Network: loopback (the egress shim on 127.0.0.1:3128) and vsock only
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
# CONFIG_NETDEVICES is not set
# CONFIG_WIRELESS is not set
# CONFIG_NETFILTER is not set
