# Kernel config fragment of the agent sandbox microVM (ADR 0040 §4), merged
# onto `make allnoconfig` for arm64 and then `make olddefconfig`.
# allnoconfig, not defconfig: with MODULES off, every =m of defconfig would
# turn into =y and build the whole driver tree in. Every line here must hold
# in the final .config; check-config.sh fails the build otherwise (an option
# whose dependencies are missing is dropped silently), and also when a symbol
# named here is not defined in the tree (a misspelt "is not set" would hold).
# olddefconfig gives every option this fragment newly exposes its upstream
# default, so the hardening defaults that allnoconfig turned off are named
# here explicitly, and so is every unwanted default.
#
# EXPERT only unhides prompts (IO_URING and VT need it). It selects
# DEBUG_KERNEL, which unhides the debug options; the two whose default
# follows DEBUG_KERNEL are named off below, the rest default to off.
#
# Guest hardware (Virtualization.framework, direct Linux boot, device tree):
# GIC, PSCI, arch timer, a PL031 RTC and virtio devices on a generic ECAM
# PCI host bridge. No network device, no initramfs, no modules.

CONFIG_LOCALVERSION="-agentkit"
# CONFIG_LOCALVERSION_AUTO is not set
# CONFIG_MODULES is not set
# CONFIG_BLK_DEV_INITRD is not set
# CONFIG_COMPAT is not set
# CONFIG_BOOT_CONFIG is not set
CONFIG_EXPERT=y
# CONFIG_DEBUG_MISC is not set
# CONFIG_RCU_TRACE is not set

# Platform
CONFIG_SMP=y
CONFIG_PCI=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_PCI_MSI=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_DRV_PL031=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y

# Userland of a normal Debian system (glibc, Python, Node, git)
CONFIG_MULTIUSER=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_AIO=y
# io_uring is a large attack surface the workload does not need; libuv and
# Python fall back to the classic syscalls when io_uring_setup is ENOSYS.
# CONFIG_IO_URING is not set
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_RSEQ=y
CONFIG_FILE_LOCKING=y
CONFIG_POSIX_TIMERS=y
CONFIG_INOTIFY_USER=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
# Debian's file(1) applies a seccomp filter and fails without it.
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_KALLSYMS=y
# No user namespaces: uid 1000 cannot build a mount namespace in which the
# empty file over /proc/cmdline could be undone.
# CONFIG_USER_NS is not set

# Memory: no swap; the balloon can migrate pages
# CONFIG_SWAP is not set
CONFIG_COMPACTION=y
CONFIG_MIGRATION=y
CONFIG_MEMORY_BALLOON=y
CONFIG_BALLOON_COMPACTION=y

# Console and terminals: hvc0 is the virtio console. No virtual terminals
# (and with them no DUMMY_CONSOLE, which only exists under VT).
CONFIG_TTY=y
# CONFIG_VT is not set
CONFIG_UNIX98_PTYS=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HVC_DRIVER=y
# agentkit-vm-init powers off through /proc/sysrq-trigger (the image has no
# poweroff binary); the keyboard functions stay off.
CONFIG_MAGIC_SYSRQ=y
CONFIG_MAGIC_SYSRQ_DEFAULT_ENABLE=0x0
# CONFIG_MAGIC_SYSRQ_SERIAL is not set
# The boot log carries the kernel command line, and with it the channel token.
CONFIG_SECURITY_DMESG_RESTRICT=y
# CONFIG_DEVMEM is not set

# Virtio
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y

# Block and filesystems
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_VIRTIO_BLK=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Network: loopback (the egress shim on 127.0.0.1:3128) and vsock only.
# AF_UNIX_OOB (MSG_OOB on unix sockets) stays on: in 6.12 it has no prompt.
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
# CONFIG_IPV6_SIT is not set
# CONFIG_INET_DIAG is not set
# CONFIG_INET_TCP_DIAG is not set
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
# CONFIG_VSOCKETS_LOOPBACK is not set
# CONFIG_VSOCKETS_DIAG is not set
# CONFIG_PACKET is not set
# CONFIG_NETDEVICES is not set
# CONFIG_WIRELESS is not set
# CONFIG_NETFILTER is not set

# Hardening. ARM64_BTI_KERNEL is left out: 6.12 allows it with clang only
# ("depends on !CC_IS_GCC"); userspace BTI is on. SHUFFLE_PAGE_ALLOCATOR is
# built in but shuffles only with page_alloc.shuffle=1 on the command line.
CONFIG_ARM64_PAN=y
CONFIG_ARM64_PTR_AUTH=y
CONFIG_ARM64_PTR_AUTH_KERNEL=y
CONFIG_ARM64_BTI=y
CONFIG_ARM64_E0PD=y
CONFIG_VMAP_STACK=y
CONFIG_RODATA_FULL_DEFAULT_ENABLED=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_RANDOM_KMALLOC_CACHES=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_LIST_HARDENED=y
CONFIG_BUG_ON_DATA_CORRUPTION=y
CONFIG_PANIC_ON_OOPS=y
CONFIG_DEFAULT_MMAP_MIN_ADDR=32768
# /proc/<pid>/mem writes past page protections only for an active tracer.
CONFIG_PROC_MEM_FORCE_PTRACE=y
# CONFIG_PROC_MEM_ALWAYS_FORCE is not set

# Off: kernel interfaces the workload never needs (most are off after
# allnoconfig already; naming them makes check-config enforce it).
# CONFIG_BPF_SYSCALL is not set
# CONFIG_USERFAULTFD is not set
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_PERF_EVENTS is not set
# CONFIG_PROC_KCORE is not set
# CONFIG_KPROBES is not set
# CONFIG_FTRACE is not set
# CONFIG_KEYS is not set
# CONFIG_CROSS_MEMORY_ATTACH is not set
# CONFIG_CHECKPOINT_RESTORE is not set
# CONFIG_BINFMT_MISC is not set
# CONFIG_FUSE_FS is not set
# CONFIG_BLK_DEV_LOOP is not set
