# Agent sandbox microVM artifacts (ADR 0040 §4-§5): the pinned build manifest.
# Sourced by vm/build.sh after ../manifest.env, whose BASE_IMAGE,
# DEBIAN_SNAPSHOT, SOURCE_DATE_EPOCH and BUILDKIT_IMAGE the VM build reuses
# (build toolchain, e2fsprogs, timestamps). Changing a line here is a new
# kernel or root disk, so a new vm-manifest.json.

VM_NAME=agentkit-sandbox-vm
VM_VERSION=v1
VM_ARCH=arm64

# Upstream longterm kernel, unpatched. sha256 from
# https://cdn.kernel.org/pub/linux/kernel/v6.x/sha256sums.asc (2026-11-27);
# BuildKit refuses the tarball unless it matches. The GPL-2.0 source of
# out/Image is this tarball plus out/kernel.config.
KERNEL_VERSION=6.12.119
KERNEL_URL=https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-6.12.119.tar.xz
KERNEL_SHA256=143b287965acb9e270095b95894e59e2eba306d7e1f6b260d4ba74fca70c0333

# Root disk: a fixed size (mkfs.ext4 fails if the image outgrows it; v1
# uses about 720 MB), and a
# fixed filesystem UUID and directory hash seed, so two builds of the same
# input give the same bytes.
ROOT_SIZE_MIB=1024
ROOT_LABEL=agentroot
ROOT_UUID=6a1c0e7e-5b0d-4c1e-9a6f-0aa1e2b3c4d5
ROOT_HASH_SEED=0d9b2f4c-3e71-4a8e-b5c6-7d8e9f0a1b2c
